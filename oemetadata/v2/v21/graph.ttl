<https://databus.openenergyplatform.org/oeplatform/supply/wri_global_power_plant_database/2022-11-07/wri_global_power_plant_database_variant=data.csv>
    rdfs:label "oemetadata_table_example"^^xsd:string ;
    sc:review <https://openenergyplatform.org/database/> ;
    csvw:decimalChar "."^^xsd:string ;
    csvw:delimiter ";"^^xsd:string ;
    csvw:encoding "UTF-8"^^xsd:string ;
    csvw:tableSchema
        [
            csvw:column (
                
                [
                    rdfs:label "id"^^xsd:string ;
                    sc:about <http://purl.obolibrary.org/obo/IAO_0020000> ;
                    csvw:datatype "integer"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    dct:description "Unique identifier"^^xsd:string ;
                ]
                
                [
                    rdfs:label "name"^^xsd:string ;
                    sc:about <http://openenergy-platform.org/ontology/oeo/OEO_00010423> ;
                    csvw:datatype "string"^^xsd:string ;
                    prov:value <http://openenergyplatform.org/ontology/oeo/OEO_00010424> ;
                    dct:description "Technology Name"^^xsd:string ;
                ]
                
                [
                    rdfs:label "type"^^xsd:string ;
                    sc:about <https://openenergyplatform.org/ontology/oeo/OEO_00000447/> ;
                    csvw:datatype "string"^^xsd:string ;
                    prov:value
                        <https://openenergyplatform.org/ontology/oeo/OEO_00000308/> ,
                        <https://openenergyplatform.org/ontology/oeo/OEO_00000311/> ;
                    dct:description "Type of wind farm"^^xsd:string ;
                ]
                
                [
                    rdfs:label "year"^^xsd:string ;
                    sc:about <https://openenergyplatform.org/ontology/oeo/UO_0000036/> ;
                    csvw:datatype "integer"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    dct:description "Reference year"^^xsd:string ;
                ]
                
                [
                    rdfs:label "value"^^xsd:string ;
                    sc:about <https://openenergyplatform.org/ontology/oeo/OEO_00230003/> ;
                    csvw:datatype "number"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    oeo:OEO_00040010 "MW"^^xsd:string ;
                    dct:description "Bruttoleistung"^^xsd:string ;
                ]
                
                [
                    rdfs:label "is_active"^^xsd:string ;
                    sc:about <https://ontology.brickschema.org/brick/Operating_Mode_Status> ;
                    csvw:datatype "boolean"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    dct:description "Betriebsstatus"^^xsd:string ;
                ]
                
                [
                    rdfs:label "version"^^xsd:string ;
                    sc:about <http://purl.obolibrary.org/obo/IAO_0000129> ;
                    csvw:datatype "string"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    dct:description "Version"^^xsd:string ;
                ]
                
                [
                    rdfs:label "comment"^^xsd:string ;
                    sc:about <http://semanticscience.org/resource/SIO_001167> ;
                    csvw:datatype "string"^^xsd:string ;
                    prov:value
                        [

                        ] ;
                    dct:description "Comment"^^xsd:string ;
                ]
            ) ;
            csvw:foreignKey
                [
                    csvw:column (
                        "version"^^xsd:string
                    ) ;
                    csvw:reference
                        [
                            csvw:column (
                                "version"^^xsd:string
                            ) ;
                            csvw:resource "example_version.csv"^^xsd:string ;
                        ] ;
                ] ;
            csvw:primaryKey "id"^^xsd:string ;
        ] ;
